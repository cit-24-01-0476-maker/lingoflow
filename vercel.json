{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/version.json", "destination": "/docs/version.json" },
    { "source": "/(.*)", "destination": "/docs/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
